{
  "name": "doctorchart-promo-reel",
  "version": "1.0.0",
  "description": "Reel DoctorChart integrado al sistema audiovisual compartido de Bycode",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@bycode/video-system": "0.1.0",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "playwright": "^1.64.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "voice:qwen": "node render/qwen.mjs",
    "render:qwen": "node render/render.mjs qwen",
    "predev": "npm --prefix .. run build:system",
    "dev": "remotion studio src/index.ts --port=3400 --no-open",
    "prerender:preview": "npm --prefix .. run build:system",
    "render:preview": "node render/render.mjs preview",
    "prerender:brand": "npm --prefix .. run build:system",
    "render:brand": "node render/render.mjs brand",
    "qa:brand": "node render/qa.mjs out/reel_preview_bycode_integrado.mp4",
    "prerender:final": "npm --prefix .. run build:system",
    "render:final": "node render/render.mjs final",
    "ingest-voice": "node render/ingest-voice.mjs",
    "prepare:preview": "node render/prepare-preview.mjs",
    "stills": "node render/render.mjs stills",
    "qa": "node render/qa.mjs",
    "prebuild": "npm --prefix .. run build:system",
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
